{
  "name": "specialist-waitlist",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b packages/shared apps/api && npm run build -w @waitlist/web",
    "test": "npm test --workspaces --if-present",
    "lint": "eslint .",
    "seed": "npm run seed -w @waitlist/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
